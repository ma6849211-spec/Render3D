-- Companion export and AI bridge retired from the plugin interface.
--[=[
label(controls, 'Local PNG & Open Cloud companion', 14, TEXT, { Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 44 })
label(controls, 'Start server.mjs with Node.js 18+. Paste its token here, never your Roblox API key.', 12, DIM, { Size = UDim2.new(1, 0, 0, 38), TextWrapped = true, LayoutOrder = 45 })
local tokenBox = new('TextBox', { Text = '', PlaceholderText = 'Companion token (session only)', ClearTextOnFocus = false, Font = Enum.Font.Code, TextSize = 12, TextColor3 = TEXT, BackgroundColor3 = PANEL, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 46 }, controls)
local projectBox = new('TextBox', { Text = 'MyProject', PlaceholderText = 'PNG project folder', ClearTextOnFocus = false, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = TEXT, BackgroundColor3 = PANEL, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 47 }, controls)
local outputBox = new('TextBox', { Text = '0', PlaceholderText = 'Output max side: 0 = native; 16–4096 (upscaled above native)', ClearTextOnFocus = false, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = TEXT, BackgroundColor3 = PANEL, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 48 }, controls)
local savePNG = button(controls, 'Save PNG via companion', ACCENT, { Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 49 })
local cloudUpload = button(controls, 'Upload via companion (configured user / group)', rgb(52, 140, 84), { Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 50 })
local function companionRequest(endpoint, body)
  if tokenBox.Text == '' then error('Start the companion and enter its printed token first.') end
  local response = HttpService:RequestAsync({
    Url = 'http://127.0.0.1:19765/' .. endpoint, Method = 'POST',
    Headers = { ['Content-Type'] = 'application/json', ['X-Icon-Token'] = tokenBox.Text },
    Body = HttpService:JSONEncode(body),
  })
  local decoded = HttpService:JSONDecode(response.Body)
  if not response.Success then error('Companion HTTP ' .. response.StatusCode .. ': ' .. tostring(decoded.error or response.Body)) end
  return decoded
end
local function companionExport(mode)
  if not state.resultBuf then error('Capture or process an icon first.') end
  local maxSide = tonumber(outputBox.Text)
  if not maxSide or maxSide ~= math.floor(maxSide) or (maxSide ~= 0 and (maxSide < 16 or maxSide > 4096)) then error('Output size must be 0 or an integer from 16 to 4096.') end
  local layout = currentLayout()
  if layout.ew > 1024 or layout.eh > 1024 then error('Set Max export size to 1024 or smaller. The companion can resize that result afterwards.') end
  local pixels = Matte.render(state.resultBuf, state.w, state.h, layout, { step = function() task.wait() return not stopRequested end })
  if not pixels or stopRequested then return end
  local started = companionRequest('begin', { name = state.name, project = projectBox.Text, width = layout.ew, height = layout.eh, maxSide = maxSide, mode = mode })
  local session, chunkIndex = started.session, 0
  local ok, err = pcall(function()
    local bytes = buffer.tostring(pixels)
    for offset = 1, #bytes, 65536 do
      if stopRequested then error('Export cancelled before upload submission.') end
      local hex = string.gsub(string.sub(bytes, offset, offset + 65535), '.', function(c) return string.format('%02x', string.byte(c)) end)
      companionRequest('chunk', { session = session, index = chunkIndex, hex = hex })
      chunkIndex += 1
      setStatus(string.format('Sending PNG pixels: %d%%', math.min(100, math.floor((offset + 65535) / #bytes * 100))), WARN)
      task.wait()
    end
    companionRequest('finish', { session = session })
    local deadline = os.clock() + 240
    while os.clock() < deadline do
      if stopRequested then error('Stopped waiting. An already submitted upload may still complete; check Creator Hub before retrying.') end
      local status = companionRequest('status', { session = session })
      if status.status == 'error' then error(status.error) end
      if status.status == 'done' then
        local result = status.result
        if result.decalId then
          local okAsset, decal = pcall(function() return InsertService:LoadAsset(tonumber(result.decalId)) end)
          local imageId
          if okAsset and decal then
            for _, d in ipairs(decal:GetDescendants()) do if d:IsA('Decal') then imageId = string.match(d.Texture, '%d+') break end end
            decal:Destroy()
          end
          if imageId then
            state.lastAssetId = tonumber(imageId)
            idBox.Text = 'rbxassetid://' .. imageId
            local history = plugin:GetSetting('Take3DIconLibrary') or {}
            table.insert(history, 1, { name = state.name, id = imageId, date = os.time() })
            while #history > 100 do table.remove(history) end
            plugin:SetSetting('Take3DIconLibrary', history)
            refreshLibrary()
            setStatus('Uploaded image ' .. imageId .. '. PNG: ' .. result.file, GOOD)
          else
            idBox.Text = 'Decal ID: ' .. result.decalId
            setStatus('Created Decal ' .. result.decalId .. ', but its image ID could not yet be resolved. Check moderation/permissions. PNG: ' .. result.file, WARN)
          end
        else
          setStatus(string.format('PNG saved: %s (%d×%d).', result.file, result.width, result.height), GOOD)
        end
        return result
      end
      setStatus(mode == 'upload' and 'Companion uploading; waiting for Roblox operation...' or 'Companion writing PNG...', WARN)
      task.wait(1)
    end
    error('Companion timed out. Check Creator Hub before retrying an upload.')
  end)
  if not ok then
    pcall(function() companionRequest('cancel', { session = session }) end)
    error(err)
  end
end
savePNG.MouseButton1Click:Connect(function() perform(companionExport, 'save') end)
cloudUpload.MouseButton1Click:Connect(function() perform(companionExport, 'upload') end)
local saveBatchPNG = button(controls, 'Save approved batch PNGs via companion', PANEL, { Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 51 })
saveBatchPNG.MouseButton1Click:Connect(function()
  perform(function()
    local count = 0
    for index, entry in ipairs(batch.items) do
      if stopRequested then break end
      if entry.approved then showBatch(index) companionExport('save') count += 1 end
    end
    setStatus('Saved ' .. count .. ' approved batch PNGs via companion.', GOOD)
  end)
end)

-- Agent commands are a small, explicit allowlist, never arbitrary Lua execution.
local agent = { mode = 'Block', pending = nil, alive = true }
local agentMode = button(controls, 'Agent permission: Block', PANEL, { Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 52 })
local agentStatus = label(controls, 'AI bridge disabled. Uploads always require approval.', 12, DIM, { Size = UDim2.new(1, 0, 0, 36), TextWrapped = true, LayoutOrder = 53 })
local agentRow = new('Frame', { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 54 }, controls)
local agentApprove = button(agentRow, 'Approve request', ACCENT, { Size = UDim2.new(0.5, -3, 1, 0) })
local agentReject = button(agentRow, 'Reject request', BAD, { Position = UDim2.new(0.5, 3, 0, 0), Size = UDim2.new(0.5, -3, 1, 0) })
plugin.Unloading:Connect(function() agent.alive = false stopRequested = true end)
local function answerAgent(job, result, err)
  pcall(function() companionRequest('agent/result', { job = job.id, result = result, error = err }) end)
end
local function resolveModel(path)
  if typeof(path) ~= 'string' then error('Agent capture needs a model path.') end
  local object = game
  for segment in string.gmatch(path, '[^%.]+') do
    if segment ~= 'game' then
      object = object:FindFirstChild(segment)
      if not object then error('Model path not found: ' .. path) end
    end
  end
  if not (object:IsA('Model') or object:IsA('BasePart')) then error('Only Model and BasePart capture targets are permitted.') end
  if not (object:IsDescendantOf(workspace) or object:IsDescendantOf(game:GetService('ReplicatedStorage')) or object:IsDescendantOf(game:GetService('ServerStorage'))) then error('Capture target must be in Workspace, ReplicatedStorage or ServerStorage.') end
  return object
end
local function runAgent(job)
  if busy then agent.pending = job return end
  agent.pending = nil
  perform(function()
    local ok, result = pcall(function()
      if job.action == 'capture' then
        if not renderModel(resolveModel(job.args.path)) then error(statusLabel.Text) end
        return { name = state.name, width = state.w, height = state.h }
      elseif job.action == 'save' then return companionExport('save')
      elseif job.action == 'upload' then return companionExport('upload')
      elseif job.action == 'library' then return plugin:GetSetting('Take3DIconLibrary') or {}
      elseif job.action == 'preset' then
        local presets = plugin:GetSetting('Take3DIconPresets') or {}
        local saved = presets[job.args.name]
        if not saved then error('Named preset not found.') end
        o.maxSide = saved.opts.maxSide
        for key, value in pairs(saved.opts) do
          o[key] = value
          local setter = controlSetters[optionControls[key]]
          if setter then setter(value) end
        end
        state.modelView = saved.view
        viewBtn.Text = 'View: ' .. state.modelView
        sizeSeg.set(o.maxSide or 0)
        return { preset = job.args.name }
      else error('Unsupported agent action') end
    end)
    answerAgent(job, ok and result or nil, not ok and tostring(result) or nil)
    agentStatus.Text = ok and ('Completed: ' .. job.action) or ('Agent error: ' .. tostring(result))
  end)
end
agentMode.MouseButton1Click:Connect(function()
  local modes = { 'Block', 'Ask', 'Allow' }
  agent.mode = modes[(table.find(modes, agent.mode) or 1) % #modes + 1]
  agentMode.Text = 'Agent permission: ' .. agent.mode
  if agent.mode == 'Block' then
    stopRequested = true
    if agent.pending then answerAgent(agent.pending, nil, 'Blocked by user') agent.pending = nil end
  end
end)
agentApprove.MouseButton1Click:Connect(function()
  if agent.mode ~= 'Block' and agent.pending then runAgent(agent.pending) end
end)
agentReject.MouseButton1Click:Connect(function()
  if agent.pending then answerAgent(agent.pending, nil, 'Rejected by user') agent.pending = nil agentStatus.Text = 'Request rejected.' end
end)
task.spawn(function()
  while agent.alive do
    task.wait(2)
    if agent.mode ~= 'Block' and tokenBox.Text ~= '' then
      local ok, result = pcall(function() return companionRequest('agent/poll', { onlyStop = agent.pending ~= nil }) end)
      if ok and result.job then
        local job = result.job
        if job.action == 'stop' then
          stopRequested = true answerAgent(job, { stopRequested = true })
        elseif agent.mode == 'Allow' and job.action ~= 'upload' and not busy then runAgent(job)
        else agent.pending = job agentStatus.Text = 'Pending ' .. job.action .. ': ' .. HttpService:JSONEncode(job.args) end
      elseif not ok then agentStatus.Text = 'Companion connection failed. Check token and HTTP permission.' end
    end
  end
end)

]=]

local previewRow = new('Frame', { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32), LayoutOrder = 23 }, controls)
local previewUI = button(previewRow, 'Preview in selected UI', ACCENT, { Size = UDim2.new(0.65, -3, 1, 0) })
local restoreUI = button(previewRow, 'Restore UI', PANEL, { Position = UDim2.new(0.65, 3, 0, 0), Size = UDim2.new(0.35, -3, 1, 0) })
restoreUI.MouseButton1Click:Connect(function() restoreUIPreview() setStatus('Original UI images restored.', GOOD) end)
previewUI.MouseButton1Click:Connect(function()
  perform(function()
    if not state.resultBuf then setStatus('Capture an icon first.', WARN) return end
    local targets = {}
    for _, selected in ipairs(Selection:Get()) do
      if selected:IsA('ImageLabel') or selected:IsA('ImageButton') then targets[#targets + 1] = selected end
    end
    if #targets == 0 then setStatus('Select one or more ImageLabels or ImageButtons in Explorer.', WARN) return end
    restoreUIPreview()
    local layout = currentLayout()
    if layout.ew > 1024 or layout.eh > 1024 then setStatus('Choose an export size of 1024 or smaller for UI preview.', WARN) return end
    local pixels = Matte.render(state.resultBuf, state.w, state.h, layout, { step = function() task.wait() return true end })
    if not pixels then return end
    if not widget.Enabled then return end
    local ok, err = pcall(function()
      uiPreview.image = AssetService:CreateEditableImage({ Size = Vector2.new(layout.ew, layout.eh) })
      if not uiPreview.image then error('Not enough EditableImage memory') end
      uiPreview.image:WritePixelsBuffer(Vector2.zero, uiPreview.image.Size, pixels)
      for _, target in ipairs(targets) do
        uiPreview.entries[#uiPreview.entries + 1] = { target = target, content = target.ImageContent }
        target.ImageContent = Content.fromObject(uiPreview.image)
      end
    end)
    if not ok then restoreUIPreview() setStatus('UI preview failed: ' .. tostring(err), BAD) return end
    setStatus('Previewing ' .. #targets .. ' UI images. Restore UI or close the plugin to undo.', GOOD)
  end)
end)

