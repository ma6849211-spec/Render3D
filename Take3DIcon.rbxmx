local tabs = new('Frame', { Position = UDim2.new(0, 12, 0.36, 228), Size = UDim2.new(1, -24, 0, 30), BackgroundTransparency = 1 }, root)
local cameraTab = button(tabs, 'Camera', ACCENT, { Size = UDim2.new(0.5, -3, 1, 0) })
local effectsTab = button(tabs, 'Effects', PANEL, { Position = UDim2.new(0.5, 3, 0, 0), Size = UDim2.new(0.5, -3, 1, 0) })
local controls = new('ScrollingFrame', { Position = UDim2.new(0, 0, 0.36, 264), Size = UDim2.new(1, 0, 0.64, -264), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y }, root)
new('UIListLayout', { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, controls)
new('UIPadding', { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 16), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 12) }, controls)

local busy = false
local function perform(action, ...)
  if busy then setStatus('Please wait for the current operation to finish.', WARN) return end
  busy = true
  stopRequested = false
  local args = table.pack(...)
  task.spawn(function()
    local ok, err = xpcall(function() action(table.unpack(args, 1, args.n)) end, debug.traceback)
    busy = false
    if not ok then setStatus('Operation failed: ' .. tostring(err), BAD) end
  end)
end
local function rerun() perform(runRemove) end
local o = state.opts
-- Camera controls preview clones locally; source models and the editor camera stay untouched.
local liveView = new('ViewportFrame', { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 5, Visible = false }, holder)
local liveWorld = Instance.new('WorldModel', liveView)
local liveCamera = Instance.new('Camera', liveView)
liveView.CurrentCamera = liveCamera
liveView.Ambient = rgb(150, 150, 150)
liveView.LightColor = rgb(255, 255, 255)
local liveTarget, liveClone
local function refreshCameraPreview()
  local selected = Selection:Get()[1]
  if selected and (selected:IsA('Model') or selected:IsA('BasePart')) and selected ~= liveTarget then
    local ok, copy = pcall(function() return selected:Clone() end)
    if not ok or not copy then return end
    liveWorld:ClearAllChildren()
    for _, d in ipairs(copy:GetDescendants()) do
      if d:IsA('BaseScript') then d:Destroy()
      elseif d:IsA('BasePart') then d.Anchored = true d.CanCollide = false end
    end
    copy.Parent = liveWorld
    liveTarget, liveClone = selected, copy
  end
  if not liveClone then return end
  local cf, size
  if liveClone:IsA('Model') then cf, size = liveClone:GetBoundingBox() else cf, size = liveClone.CFrame, liveClone.Size end
  local viewport = liveView.AbsoluteSize
  if viewport.X < 1 or viewport.Y < 1 then return end
  local vfov = math.rad(o.fov)
  local hfov = 2 * math.atan(math.tan(vfov / 2) * viewport.X / math.max(viewport.Y, 1))
  local distance = math.max(size.Magnitude / 2, 0.5) / math.sin(math.min(vfov, hfov) / 2) * 1.08 * 100 / o.zoom
  local direction = (VIEW_DIRS[state.modelView] or VIEW_DIRS['3/4']).Unit
  if state.modelView == 'Custom' then
    local yaw, pitch = math.rad(o.yaw), math.rad(o.pitch)
    direction = Vector3.new(math.sin(yaw) * math.cos(pitch), math.sin(pitch), -math.cos(yaw) * math.cos(pitch))
  end
  liveCamera.FieldOfView = o.fov
  liveCamera.CFrame = CFrame.lookAt(cf.Position + direction * distance, cf.Position)
    * CFrame.new(size.Magnitude * o.panX / 100, size.Magnitude * o.panY / 100, 0)
    * CFrame.Angles(0, 0, math.rad(o.roll))
  preview.Visible = false
  liveView.Visible = true
  emptyLabel.Visible = false
end
Selection.SelectionChanged:Connect(refreshCameraPreview)
liveView.Active = true
liveView.InputChanged:Connect(function(input)
  if input.UserInputType ~= Enum.UserInputType.MouseWheel or busy then return end
  o.zoom = math.clamp(o.zoom + input.Position.Z * 5, 50, 180)
  local setZoom = controlSetters['Camera zoom (%)']
  if setZoom then setZoom(o.zoom) end
  refreshCameraPreview()
end)
liveView:GetPropertyChangedSignal('AbsoluteSize'):Connect(function()
  if liveView.Visible then refreshCameraPreview() end
end)
-- Once a rendered image arrives, show the actual processed result instead.
preview:GetPropertyChangedSignal('ImageContent'):Connect(function()
  liveView.Visible = false
  preview.Visible = true
end)
plugin.Unloading:Connect(function() liveWorld:ClearAllChildren() end)
