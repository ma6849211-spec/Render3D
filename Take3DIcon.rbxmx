removeBtn.MouseButton1Click:Connect(rerun)
resetBtn.MouseButton1Click:Connect(function()
  if busy then return end
  restoreUIPreview()
  state.token += 1
  if state.resultImg then state.resultImg:Destroy() end
  state.lastAssetId = nil
  state.resultImg, state.resultBuf, state.bbox = nil, nil, nil
  state.bgColor, state.pickMode = nil, false
  updateSwatch()
  setView('Original')
  setStatus('Back to the original image.', DIM)
end)
uploadBtn.MouseButton1Click:Connect(function() perform(function() uploadResult() refreshLibrary() end) end)

preview.InputBegan:Connect(function(input)
  if not state.pickMode or input.UserInputType ~= Enum.UserInputType.MouseButton1 or not state.origBuf then return end
  local rel = Vector2.new(input.Position.X, input.Position.Y) - preview.AbsolutePosition
  local size = preview.AbsoluteSize
  local px = math.clamp(math.floor(rel.X / math.max(size.X, 1) * state.w), 0, state.w - 1)
  local py = math.clamp(math.floor(rel.Y / math.max(size.Y, 1) * state.h), 0, state.h - 1)
  local i = (py * state.w + px) * 4
  state.bgColor = { readu8(state.origBuf, i), readu8(state.origBuf, i + 1), readu8(state.origBuf, i + 2), readu8(state.origBuf, i + 3) }
  state.pickMode = false
  updateSwatch()
  rerun()
end)

makeChecker()
setBackdrop('Checker')
updateSwatch()
refreshInfo()
setStatus('Ready.', GOOD)
setTab('Camera')

