local library = new('TextBox', { Text = '', ClearTextOnFocus = false, MultiLine = true, TextEditable = false, TextWrapped = true, Font = Enum.Font.Code, TextSize = 12, TextColor3 = TEXT, BackgroundColor3 = PANEL, Size = UDim2.new(1, 0, 0, 100), LayoutOrder = 22, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top }, controls)
local librarySearch = new('TextBox', { Text = '', PlaceholderText = 'Search uploads by name or asset ID', ClearTextOnFocus = false, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = TEXT, BackgroundColor3 = PANEL, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 21 }, controls)
local function refreshLibrary()
  local history = plugin:GetSetting('Take3DIconLibrary') or {}
  local lines = {}
  if typeof(history) == 'table' then
    for i, entry in ipairs(history) do
      local line = tostring(entry.name) .. ': rbxassetid://' .. tostring(entry.id)
      if string.find(string.lower(line), string.lower(librarySearch.Text), 1, true) then
        lines[#lines + 1] = line
      end
      if #lines >= 8 then break end
    end
  end
  library.Text = #lines > 0 and table.concat(lines, '\n') or 'No matching uploads.'
end
librarySearch:GetPropertyChangedSignal('Text'):Connect(refreshLibrary)
refreshLibrary()

