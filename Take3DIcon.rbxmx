makeSlider(controls, 29, 'Camera yaw', -180, 180, o.yaw, function(v) o.yaw = v state.modelView = 'Custom' viewBtn.Text = 'View: Custom' refreshCameraPreview() end)
makeSlider(controls, 30, 'Camera pitch', -80, 80, o.pitch, function(v) o.pitch = v state.modelView = 'Custom' viewBtn.Text = 'View: Custom' refreshCameraPreview() end)
makeSlider(controls, 31, 'Camera roll', -180, 180, o.roll, function(v) o.roll = v refreshCameraPreview() end)
makeSlider(controls, 32, 'Camera zoom (%)', 50, 180, o.zoom, function(v) o.zoom = v refreshCameraPreview() end)
local function setTab(tabName)
  cameraTab.BackgroundColor3 = tabName == 'Camera' and ACCENT or PANEL
  effectsTab.BackgroundColor3 = tabName == 'Effects' and ACCENT or PANEL
  for _, child in ipairs(controls:GetChildren()) do
    if child:IsA('GuiObject') then
      local isCameraControl = (child.LayoutOrder >= 29 and child.LayoutOrder <= 33) or child.LayoutOrder == 60 or child.LayoutOrder == 61
      local isAction = child.LayoutOrder == 0 or (child.LayoutOrder >= 36 and child.LayoutOrder <= 38)
      child.Visible = (tabName == 'Camera' and (isCameraControl or isAction)) or (tabName == 'Effects' and not isCameraControl)
    end
  end
end
cameraTab.MouseButton1Click:Connect(function() setTab('Camera') end)
effectsTab.MouseButton1Click:Connect(function() setTab('Effects') end)
setTab('Camera')
optionControls.glow, optionControls.shadow = 'Soft blue glow', 'Drop shadow'
optionControls.auraRadius, optionControls.yaw, optionControls.pitch = 'Glow / shadow radius', 'Camera yaw', 'Camera pitch'
optionControls.roll, optionControls.zoom = 'Camera roll', 'Camera zoom (%)'
controlSetters['Style'] = function(v) styleBtn.Text = 'Style: ' .. v end
optionControls.style = 'Style'

-- Reviewable, memory-bounded batch.
local batch = { items = {}, index = 0 }
local workflow = { plan = nil }
local variants = { 'Original', 'Red', 'Blue', 'Gold' }
local batchText = label(controls, 'Set camera and effects first, then render one selected model.', 12, DIM, { Size = UDim2.new(1, 0, 0, 36), TextWrapped = true, LayoutOrder = 36 })
local startBatch = button(actionRow2, 'Render selected icon', ACCENT, { Size = UDim2.new(0.5, -3, 1, 0) })
local function snapshot(target)
  return { target = target, name = state.name, w = state.w, h = state.h, source = state.origBuf,
    result = state.resultBuf, bbox = state.bbox, kind = state.kind, approved = true, view = state.modelView, opts = HttpService:JSONDecode(HttpService:JSONEncode(o)) }
end
local function showBatch(index, restoreOptions)
  local entry = batch.items[index]
  if not entry then return end
  local img = AssetService:CreateEditableImage({ Size = Vector2.new(entry.w, entry.h) })
  if not img then error('Not enough image memory to review this icon') end
  img:WritePixelsBuffer(Vector2.zero, img.Size, entry.source)
  if not setSource(img, entry.name, entry.kind) then img:Destroy() return end
  state.origBuf = entry.source
  applyResult(entry.result, entry.bbox)
  if restoreOptions ~= false then
    o.maxSide = entry.opts.maxSide
    for key, value in pairs(entry.opts) do
      o[key] = value
      local setter = controlSetters[optionControls[key]]
      if setter then setter(value) end
    end
    state.modelView = entry.view or '3/4'
    viewBtn.Text = 'View: ' .. state.modelView
    sizeSeg.set(o.maxSide or 0)
  end
  batch.index = index
  batchText.Text = string.format('%d/%d · %s · %s', index, #batch.items, entry.name, entry.approved and 'KEEP' or 'SKIP')
end
startBatch.MouseButton1Click:Connect(function()
  perform(renderModel)
end)

-- Retired workflow recipe and lighting controls; batches use the selection.
--[=[
label(controls, 'Workflow recipe: Variant@Preset@requiredBooleanAttribute', 12, DIM, { Size = UDim2.new(1, 0, 0, 32), TextWrapped = true, LayoutOrder = 55 })
local recipeBox = new('TextBox', { Text = 'Original;Gold', PlaceholderText = 'Original@Default;Gold@Golden@GoldenAllowed', ClearTextOnFocus = false, Font = Enum.Font.Code, TextSize = 12, TextColor3 = TEXT, BackgroundColor3 = PANEL, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 56 }, controls)
local planButton = button(controls, 'Plan workflow on selected models (no capture)', PANEL, { Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 57 })
local clearPlan = button(controls, 'Clear workflow plan · use normal selection batch', PANEL, { Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 58 })
planButton.MouseButton1Click:Connect(function()
  if busy then return end
  local ok, err = pcall(function()
    local plan, lines = {}, {}
    local presets = plugin:GetSetting('Take3DIconPresets') or {}
    for _, target in ipairs(selectedModels()) do
      for _, stepText in ipairs(string.split(recipeBox.Text, ';')) do
        local fields = string.split(stepText, '@')
        local variant = string.match(fields[1], '^%s*(.-)%s*$')
        if not table.find(variants, variant) then error('Unknown variant: ' .. variant) end
        local preset = fields[2] and fields[2] ~= '' and presets[fields[2]] or nil
        if fields[2] and fields[2] ~= '' and not preset then error('Preset not found: ' .. fields[2]) end
        local required = fields[3]
        if not required or required == '' or target:GetAttribute(required) == true then
          local opts = HttpService:JSONDecode(HttpService:JSONEncode(o))
          if preset then
            opts.maxSide = preset.opts.maxSide
            for key, value in pairs(preset.opts) do opts[key] = value end
          end
          opts.variant = variant
          plan[#plan + 1] = { target = target, opts = opts, view = preset and preset.view or state.modelView }
          lines[#lines + 1] = target.Name .. ' / ' .. variant
        end
      end
    end
    if #plan == 0 then error('No matching models or workflow steps.') end
    if #plan > 24 then error('Plan exceeds the 24-icon memory limit.') end
    workflow.plan = plan
    batchText.Text = 'PLAN ' .. #plan .. ' icons: ' .. table.concat(lines, ', ')
    setStatus('Plan prepared without changing source models. Capture selected batch will run this plan.', GOOD)
  end)
  if not ok then setStatus(tostring(err), BAD) end
end)
clearPlan.MouseButton1Click:Connect(function() if not busy then workflow.plan = nil batchText.Text = 'Workflow cleared. Next batch uses the current selection.' end end)
local lightOptions = { 'Scene', 'Bright studio', 'Dramatic', 'Flat' }
local lightButton = button(controls, 'Lighting: Scene', PANEL, { Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 59 })
lightButton.MouseButton1Click:Connect(function()
  if busy then return end
  o.lightPreset = lightOptions[(table.find(lightOptions, o.lightPreset) or 1) % #lightOptions + 1]
  lightButton.Text = 'Lighting: ' .. o.lightPreset
end)
controlSetters['Lighting'] = function(v) lightButton.Text = 'Lighting: ' .. v end
optionControls.lightPreset = 'Lighting'
