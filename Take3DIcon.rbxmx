<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>
	<Item class="Script" referent="RBX4E107780C4FB49D0AD20D37938373261">
		<Properties>
			<ProtectedString name="Source"><![CDATA[--!nocheck
-- Remove bg: Roblox Studio plugin.
-- Load a PNG/JPG from your PC, a Roblox image ID, or render a selected model, and the background is removed.
if not plugin then return end

local Matte = require(script:WaitForChild('Matte'))
local Effects = require(script:WaitForChild('IconEffects'))
local HttpService = game:GetService('HttpService')

local AssetService = game:GetService('AssetService')
local StudioService = game:GetService('StudioService')
local Selection = game:GetService('Selection')
local InsertService = game:GetService('InsertService')
local CaptureService = game:GetService('CaptureService')
local StarterGui = game:GetService('StarterGui')
local ChangeHistoryService = game:GetService('ChangeHistoryService')
local Lighting = game:GetService('Lighting')

local readu8 = buffer.readu8

---------------------------------------------------------------- look
local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end
-- Polished dark creator-tool palette: deep ink surfaces, cool borders, vivid periwinkle accent.
local BG, PANEL, BORDER = rgb(15, 18, 28), rgb(25, 30, 44), rgb(50, 59, 79)
local TEXT, DIM = rgb(241, 243, 250), rgb(153, 163, 184)
local ACCENT, GOOD, WARN, BAD = rgb(124, 116, 255), rgb(76, 201, 145), rgb(255, 190, 92), rgb(255, 103, 125)

local function new(class, props, parent)
  local inst = Instance.new(class)
  for k, v in pairs(props) do inst[k] = v end
  if parent then inst.Parent = parent end
  return inst
end
local function corner(inst, r) new('UICorner', { CornerRadius = UDim.new(0, r) }, inst) end
local function stroke(inst, color)
  new('UIStroke', { Color = color, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, inst)
end
local function label(parent, text, size, color, props)
  local p = { Text = text, Font = Enum.Font.Gotham, TextSize = size, TextColor3 = color, BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left }
  for k, v in pairs(props or {}) do p[k] = v end
  return new('TextLabel', p, parent)
end
local function button(parent, text, color, props)
  local p = { Text = text, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = TEXT, BackgroundColor3 = color, Size = UDim2.new(0, 100, 0, 30), BorderSizePixel = 0 }
  for k, v in pairs(props or {}) do p[k] = v end
  local b = new('TextButton', p, parent)
  corner(b, 9)
  local edge = new('UIStroke', { Color = BORDER, Transparency = 0.18, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, b)
  b.AutoButtonColor = false
  local base = b.BackgroundColor3
  b.MouseEnter:Connect(function()
    b.BackgroundColor3 = base:Lerp(rgb(255, 255, 255), 0.08)
    edge.Transparency = 0
  end)
  b.MouseLeave:Connect(function()
    b.BackgroundColor3 = base
    edge.Transparency = 0.18
  end)
  b.MouseButton1Down:Connect(function() b.BackgroundColor3 = base:Lerp(rgb(0, 0, 0), 0.12) end)
  b.MouseButton1Up:Connect(function() if b:IsDescendantOf(game) then b.BackgroundColor3 = base:Lerp(rgb(255, 255, 255), 0.08) end end)
  return b
end

local function makeSegmented(parent, options, selected, onSelect, props)
  local frame = new('Frame', props or {}, parent)
  frame.BackgroundTransparency = 1
  new('UIListLayout', { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4) }, frame)
  local buttons = {}
  local function highlight(value)
    for _, entry in ipairs(buttons) do
      entry.button.BackgroundColor3 = (entry.value == value) and ACCENT or PANEL
    end
  end
  for _, opt in ipairs(options) do
    local b = button(frame, opt[1], PANEL, { Size = UDim2.new(1 / #options, -4, 1, 0), TextSize = 12 })
    buttons[#buttons + 1] = { button = b, value = opt[2] }
    b.MouseButton1Click:Connect(function()
      highlight(opt[2])
      onSelect(opt[2])
    end)
  end
  highlight(selected)
  return { frame = frame, set = highlight }
end

local controlSetters = {}
local function makeToggle(parent, order, text, value, onChange)
  local row = new('Frame', { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = order }, parent)
  label(row, text, 13, TEXT, { Size = UDim2.new(1, -52, 1, 0) })
  local pill = new('TextButton', { Text = '', AutoButtonColor = false, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(40, 20), BackgroundColor3 = BORDER }, row)
  corner(pill, 10)
  local knob = new('Frame', { AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 2, 0.5, 0), BackgroundColor3 = rgb(255, 255, 255) }, pill)
  corner(knob, 8)
  local function apply()
    pill.BackgroundColor3 = value and ACCENT or BORDER
    knob.Position = value and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
  end
  apply()
  controlSetters[text] = function(v) value = v apply() end
  pill.MouseButton1Click:Connect(function()
    value = not value
    apply()
    onChange(value)
  end)
end

---------------------------------------------------------------- state + widget
local state = {
  w = 0, h = 0, name = '', kind = nil,
  origImg = nil, origBuf = nil, resultImg = nil, resultBuf = nil, bbox = nil,
  bgColor = nil, pickMode = false, token = 0, lastAssetId = nil, modelView = '3/4',
  opts = {
    tolerance = 20, softness = 2, edgeShift = 0, defringe = true, keepLargest = true, removeHoles = false, autoCrop = true, maxSide = nil,
    protectBright = true,
    fov = 90, brightness = 100,
    strokeOn = false, strokeWidth = 4, strokeColor = { 255, 255, 255 },
    style = 'Clean', glow = false, shadow = false, auraRadius = 8,
    yaw = 0, pitch = 15, roll = 0, zoom = 100,
    animationId = '', poseTime = 0, variant = 'Original',
    lightPreset = 'Scene', panX = 0, panY = 0, exportPadding = 16,
  },
}
local VIEW_ORDER = { '3/4', 'Front', 'Back', 'Side', 'Top' }
local VIEW_DIRS = {
  ['3/4'] = Vector3.new(0.7, 0.35, -0.9),
  Front = Vector3.new(0, 0.12, -1),
  Back = Vector3.new(0, 0.12, 1),
  Side = Vector3.new(1, 0.12, 0),
  Top = Vector3.new(0, 1, -0.05),
}

local toolbar = plugin:CreateToolbar('Render3D')
local toggleButton = toolbar:CreateButton('Render3D', 'Capture models, refine icons and upload images', 'rbxassetid://118332118882244', 'Render3D')
local widget = plugin:CreateDockWidgetPluginGui('RemoveBGWidget', DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Float, true, true, 440, 740, 360, 520))
widget.Enabled = true
widget.Title = 'Render3D  ·  Studio'
widget.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
toggleButton.Click:Connect(function() widget.Enabled = not widget.Enabled end)
widget:GetPropertyChangedSignal('Enabled'):Connect(function() toggleButton:SetActive(widget.Enabled) end)

local root = new('Frame', { Size = UDim2.fromScale(1, 1), BackgroundColor3 = BG, BorderSizePixel = 0 }, widget)

local setView, updateSwatch, runRemove, setBackdrop

local function makeSlider(parent, order, text, min, max, value, onCommit)
  local row = new('Frame', { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = order }, parent)
  label(row, text, 13, TEXT, { Size = UDim2.new(1, -60, 0, 18) })
  local valueLabel = label(row, '', 13, ACCENT, { Position = UDim2.new(1, -56, 0, 0), Size = UDim2.fromOffset(56, 18), TextXAlignment = Enum.TextXAlignment.Right })
  local track = new('Frame', { Position = UDim2.new(0, 0, 0, 27), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = BORDER }, row)
  corner(track, 3)
  local fill = new('Frame', { Size = UDim2.fromScale(0, 1), BackgroundColor3 = ACCENT }, track)
  corner(fill, 3)
  local knob = new('Frame', { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = rgb(255, 255, 255), ZIndex = 3 }, track)
  corner(knob, 7)
  local hit = new('TextButton', { Text = '', AutoButtonColor = false, BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 16), Size = UDim2.new(1, 0, 0, 24), ZIndex = 4 }, row)
  local current, dragging = value, false
  local function refresh()
    local t = (current - min) / (max - min)
    fill.Size = UDim2.fromScale(t, 1)
    knob.Position = UDim2.fromScale(t, 0.5)
    valueLabel.Text = tostring(current)
  end
  local function setFromX(x)
    local t = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
    current = math.floor(min + t * (max - min) + 0.5)
    refresh()
  end
  local function finish()
    if dragging then
      dragging = false
      onCommit(current)
    end
  end
  local function onMove(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then setFromX(input.Position.X) end
  end
  local function onUp(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then finish() end
  end
  hit.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
      dragging = true
      setFromX(input.Position.X)
    end
  end)
  hit.InputChanged:Connect(onMove)
  hit.InputEnded:Connect(onUp)
  root.InputChanged:Connect(onMove)
  root.InputEnded:Connect(onUp)
  refresh()
  controlSetters[text] = function(v) current = math.clamp(v, min, max) refresh() end
end

---------------------------------------------------------------- top of the window
label(root, 'Render3D', 20, TEXT, { Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(14, 9), Size = UDim2.new(1, -28, 0, 25) })
local nameLabel = label(root, 'CAPTURE  /  REFINE  /  PUBLISH', 10, DIM, { Font = Enum.Font.GothamMedium, Position = UDim2.fromOffset(15, 35), Size = UDim2.new(1, -30, 0, 14), TextTruncate = Enum.TextTruncate.AtEnd })

local sourceRow = new('Frame', { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 52), Size = UDim2.new(1, -24, 0, 28) }, root)
new('UIListLayout', { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }, sourceRow)
local importBtn = button(sourceRow, 'Import file', ACCENT, { Size = UDim2.new(0.34, -4, 1, 0) })
local modelBtn = button(sourceRow, 'Use selected model', PANEL, { Size = UDim2.new(0.40, -4, 1, 0) })
local viewBtn = button(sourceRow, 'View: 3/4', PANEL, { Size = UDim2.new(0.26, -4, 1, 0) })
stroke(modelBtn, BORDER)
stroke(viewBtn, BORDER)

local idBox = new('TextBox', { Text = '', PlaceholderText = 'Roblox image ID or link', PlaceholderColor3 = DIM, ClearTextOnFocus = false, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left, BackgroundColor3 = PANEL, Position = UDim2.fromOffset(12, 86), Size = UDim2.new(1, -96, 0, 28) }, root)
corner(idBox, 6)
stroke(idBox, BORDER)
new('UIPadding', { PaddingLeft = UDim.new(0, 8) }, idBox)
local copyIdBtn = button(root, 'Copy ID', ACCENT, { Position = UDim2.new(1, -78, 0, 86), Size = UDim2.fromOffset(66, 28) })

local previewFrame = new('Frame', { Position = UDim2.fromOffset(12, 124), Size = UDim2.new(1, -24, 0.36, 0), BackgroundColor3 = rgb(33, 39, 54), ClipsDescendants = true, BorderSizePixel = 0 }, root)
corner(previewFrame, 12)
stroke(previewFrame, BORDER)
local checker = new('ImageLabel', { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Tile, TileSize = UDim2.fromOffset(20, 20), ZIndex = 1 }, previewFrame)
local holder = new('Frame', { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 2 }, previewFrame)
new('UIPadding', { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, holder)
local preview = new('ImageLabel', { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 3 }, holder)
local aspect = new('UIAspectRatioConstraint', { AspectRatio = 1 }, preview)
local emptyLabel = label(previewFrame, 'Nothing loaded yet', 14, rgb(90, 94, 104), { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4 })

local viewRow = new('Frame', { BackgroundTransparency = 1, Position = UDim2.new(0, 12, 0.36, 130), Size = UDim2.new(1, -24, 0, 26) }, root)
local viewSeg = makeSegmented(viewRow, { { 'Result', 'Result' }, { 'Original', 'Original' } }, 'Result', function(v) setView(v) end, { Size = UDim2.new(0.38, 0, 1, 0) })
local backdropSeg = makeSegmented(viewRow, { { 'Checker', 'Checker' }, { 'White', 'White' }, { 'Black', 'Black' }, { 'Green', 'Green' } }, 'Checker', function(v) setBackdrop(v) end, { Position = UDim2.new(0.40, 0, 0, 0), Size = UDim2.new(0.60, 0, 1, 0) })

local infoLabel = label(root, '', 12, DIM, { Position = UDim2.new(0, 12, 0.36, 162), Size = UDim2.new(1, -24, 0, 30), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
local statusLabel = label(root, 'Ready.', 12, GOOD, { Position = UDim2.new(0, 12, 0.36, 194), Size = UDim2.new(1, -24, 0, 28), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })

---------------------------------------------------------------- helpers
local function setStatus(text, color)
  statusLabel.Text = text
  statusLabel.TextColor3 = color or DIM
end

local function setImageOn(target, img)
  local ok, err = pcall(function() target.ImageContent = Content.fromObject(img) end)
  if not ok then setStatus('Could not show the image: ' .. tostring(err), BAD) end
end

local function makeChecker()
  local ok, img = pcall(function()
    local e = AssetService:CreateEditableImage({ Size = Vector2.new(16, 16) })
    local b = buffer.create(16 * 16 * 4)
    for y = 0, 15 do
      for x = 0, 15 do
        local light = ((x // 8) + (y // 8)) % 2 == 0
        local v = light and 226 or 186
        local i = (y * 16 + x) * 4
        buffer.writeu8(b, i, v)
        buffer.writeu8(b, i + 1, v)
        buffer.writeu8(b, i + 2, v)
        buffer.writeu8(b, i + 3, 255)
      end
    end
    e:WritePixelsBuffer(Vector2.zero, Vector2.new(16, 16), b)
    return e
  end)
  if ok then setImageOn(checker, img) end
end

local BACKDROPS = { White = rgb(255, 255, 255), Black = rgb(0, 0, 0), Green = rgb(0, 177, 64) }
setBackdrop = function(mode)
  checker.Visible = (mode == 'Checker')
  if BACKDROPS[mode] then previewFrame.BackgroundColor3 = BACKDROPS[mode] end
  backdropSeg.set(mode)
end

local function currentLayout()
  local o = state.opts
  local strokePad = (o.strokeOn and math.max(0, o.strokeWidth) or 0) + 2
  local auraPad = (o.glow or o.shadow) and o.auraRadius * 2 or 0
  return Matte.exportLayout(state.w, state.h, state.bbox, { autoCrop = o.autoCrop, pad = o.exportPadding + strokePad + auraPad, snap = 8, maxSide = o.maxSide })
end

local function refreshInfo()
  emptyLabel.Visible = (state.origImg == nil)
  if not state.origImg then
    infoLabel.Text = ''
    return
  end
  local shown = preview.AbsoluteSize
  local text = string.format('Native %d×%d · Shown %d×%d', state.w, state.h, math.floor(shown.X), math.floor(shown.Y))
  local color = DIM
  if state.resultBuf then
    local L = currentLayout()
    text = text .. string.format(' · Export %d×%d', L.ew, L.eh)
    if math.max(L.ew, L.eh) > 1024 then
      text = text .. ' · over the 1024 px texture limit'
      color = WARN
    end
  end
  infoLabel.Text = text
  infoLabel.TextColor3 = color
end
preview:GetPropertyChangedSignal('AbsoluteSize'):Connect(refreshInfo)

setView = function(view)
  viewSeg.set(view)
  local img = (view == 'Result' and state.resultImg) or state.origImg
  if img then
    setImageOn(preview, img)
    aspect.AspectRatio = state.w / math.max(state.h, 1)
  else
    pcall(function() preview.ImageContent = Content.none end)
  end
  refreshInfo()
end

local uiPreview = { entries = {}, image = nil }
local function restoreUIPreview()
  for _, entry in ipairs(uiPreview.entries) do
    pcall(function() entry.target.ImageContent = entry.content end)
  end
  table.clear(uiPreview.entries)
  if uiPreview.image then uiPreview.image:Destroy() uiPreview.image = nil end
end
widget:GetPropertyChangedSignal('Enabled'):Connect(function()
  if not widget.Enabled then restoreUIPreview() end
end)
plugin.Unloading:Connect(restoreUIPreview)

local function applyResult(buf, bbox)
  restoreUIPreview()
  state.lastAssetId = nil
  local size = Vector2.new(state.w, state.h)
  if not state.resultImg or state.resultImg.Size ~= size then
    if state.resultImg then state.resultImg:Destroy() end
    state.resultImg = AssetService:CreateEditableImage({ Size = size })
  end
  state.resultImg:WritePixelsBuffer(Vector2.zero, size, buf)
  state.resultBuf = buf
  state.bbox = bbox
  setView('Result')
end

local function setSource(img, name, kind)
  local size = img.Size
  local ok, buf = pcall(function() return img:ReadPixelsBuffer(Vector2.zero, size) end)
  if not ok then
    setStatus('Could not read the pixels: ' .. tostring(buf), BAD)
    return false
  end
  state.token += 1
  restoreUIPreview()
  if state.resultImg then state.resultImg:Destroy() end
  if state.origImg and state.origImg ~= img then state.origImg:Destroy() end
  state.origImg, state.origBuf = img, buf
  state.w, state.h = math.floor(size.X + 0.5), math.floor(size.Y + 0.5)
  state.name, state.kind = name, kind
  state.resultImg, state.resultBuf, state.bbox = nil, nil, nil
  state.bgColor, state.pickMode = nil, false
  state.lastAssetId = nil
  nameLabel.Text = name
  updateSwatch()
  setView('Original')
  return true
end

local function loadContent(content)
  local ok, res = pcall(function() return AssetService:CreateEditableImageAsync(content) end)
  if ok and res then return res end
  return nil, tostring(res)
end

---------------------------------------------------------------- post-processing (stroke, brightness)
local function postProcess(buf, hooks)
  local o = state.opts
  if o.brightness ~= 100 then
    buf = Matte.applyBrightness(buf, state.w, state.h, o.brightness / 100, hooks)
    if not buf then return nil end
  end
  if o.strokeOn and o.strokeWidth > 0 then
    buf = Matte.applyStroke(buf, state.w, state.h, o.strokeWidth, o.strokeColor, hooks)
    if not buf then return nil end
  end
  buf = Effects.apply(buf, state.w, state.h, o.style, hooks)
  if not buf then return nil end
  if o.glow then buf = Effects.aura(buf, state.w, state.h, o.auraRadius, false, hooks) end
  if not buf then return nil end
  if o.shadow then buf = Effects.aura(buf, state.w, state.h, o.auraRadius, true, hooks) end
  return buf
end

---------------------------------------------------------------- remove the background
runRemove = function()
  if not state.origBuf then
    setStatus('Load an image first.', WARN)
    return
  end
  state.token += 1
  local token = state.token
  local function sourceCurrent() return token == state.token end
  if state.kind == 'image' and state.opts.preserveAlpha ~= false then
    -- A translucent rectangle is not a cutout. Only trust a predominantly
    -- fully transparent perimeter; all other images still need cleanup.
    local clear, total = 0, 0
    local function sample(x, y)
      total += 1
      if readu8(state.origBuf, (y * state.w + x) * 4 + 3) <= 4 then clear += 1 end
    end
    for x = 0, state.w - 1 do sample(x, 0) sample(x, state.h - 1) end
    for y = 1, state.h - 2 do sample(0, y) sample(state.w - 1, y) end
    if total > 0 and clear / total >= 0.95 and not state.bgColor then
      local out = buffer.create(buffer.len(state.origBuf))
      buffer.copy(out, 0, state.origBuf)
      out = postProcess(out, { step = function() task.wait() return sourceCurrent() end })
      if not sourceCurrent() then return end
      if out then applyResult(out, nil) end
      setStatus('Clear outer background detected; original cutout preserved. Use Pick from image to remove any remaining background.', GOOD)
      return
    end
  end
  if state.kind == 'model' or state.kind == 'scene' then
    local out = buffer.create(buffer.len(state.origBuf))
    buffer.copy(out, 0, state.origBuf)
    out = postProcess(out, { step = function() task.wait() return sourceCurrent() end })
    if not sourceCurrent() then return end
    if out then applyResult(out, state.bbox) end
    setStatus('Model icon effects updated. Capture again to change the camera.', GOOD)
    return
  end
  local o = state.opts
  local t0 = os.clock()
  setStatus('Removing background...', WARN)
  local hooks = {
    step = function(frac, text)
      if token ~= state.token then return false end
      setStatus(string.format('%s... %d%%', text, math.floor(frac * 100)), WARN)
      task.wait()
      return true
    end,
  }
  local ok, out, info = pcall(Matte.process, state.origBuf, state.w, state.h, {
    tolerance = o.tolerance, softness = o.softness, edgeShift = o.edgeShift,
    defringe = o.defringe, keepLargest = o.keepLargest, removeHoles = o.removeHoles,
    protectBright = o.protectBright,
    bgColor = state.bgColor,
  }, hooks)
  if token ~= state.token then return end
  if not ok then
    setStatus('Something went wrong: ' .. tostring(out), BAD)
    return
  end
  if not out then return end
  out = postProcess(out, hooks)
  if token ~= state.token or not out then return end
  applyResult(out, info.bbox)
  if not info.bbox or info.subjectFraction < 0.02 then
    setStatus('Almost nothing is left. The subject may be the same colour as the background. Lower Tolerance or use Pick from image.', WARN)
  elseif info.subjectFraction > 0.97 then
    setStatus('Almost nothing was removed. Use Pick from image and click the background.', WARN)
  else
    setStatus(string.format('Ready. (%.1fs)', os.clock() - t0), GOOD)
  end
end

---------------------------------------------------------------- sources
local function importFile()
  setStatus('Choose an image file...', DIM)
  local ok, file = pcall(function() return StudioService:PromptImportFile({ 'png', 'jpg', 'jpeg', 'bmp', 'tga' }) end)
  if not ok then
    setStatus('Import failed: ' .. tostring(file), BAD)
    return
  end
  if not file then
    setStatus('Import cancelled.', DIM)
    return
  end
  setStatus('Reading the image...', WARN)
  local ok2, img = pcall(function() return AssetService:CreateEditableImageAsync(Content.fromUri(file:GetTemporaryId())) end)
  if not ok2 or not img then
    setStatus('Could not read that image: ' .. tostring(img), BAD)
    return
  end
  if setSource(img, file.Name, 'image') then runRemove() end
end

local function loadById(text)
  local id = tonumber(string.match(text or '', '(%d+)'))
  if not id then
    setStatus('Paste a Roblox image ID or link first.', WARN)
    return
  end
  setStatus('Loading rbxassetid://' .. id .. '...', WARN)
  local img, err = loadContent(Content.fromAssetId(id))
  if not img then
    -- a Decal ID points at a wrapper: look inside for the real image ID
    local okM, model = pcall(function() return InsertService:LoadAsset(id) end)
    if okM and model then
      local inner
      for _, d in ipairs(model:GetDescendants()) do
        if d:IsA('Decal') or d:IsA('Texture') then
          inner = d.Texture
          break
        end
      end
      model:Destroy()
      local innerId = inner and tonumber(string.match(inner, '(%d+)'))
      if innerId and innerId ~= id then img, err = loadContent(Content.fromAssetId(innerId)) end
    end
  end
  if not img then
    setStatus('Could not load that asset (Studio only opens images you own or that Roblox allows): ' .. tostring(err), BAD)
    return
  end
  if setSource(img, 'rbxassetid://' .. id, 'image') then runRemove() end
end

local RunService = game:GetService('RunService')
local function settle()
  -- give Studio a few real frames to redraw the viewport before a screenshot
  for _ = 1, 5 do RunService.Heartbeat:Wait() end
  task.wait(0.6)
end

local function takeScreenshot()
  local contentId, done = nil, false
  local ok, err = pcall(function()
    CaptureService:CaptureScreenshot(function(id)
      contentId = id
      done = true
    end)
  end)
  if not ok then return nil, tostring(err) end
  local t0 = os.clock()
  while not done and os.clock() - t0 < 15 do task.wait() end
  if not contentId then return nil, 'the screenshot never came back' end
  local img, err2 = loadContent(Content.fromUri(contentId))
  if not img then return nil, err2 end
  return img
end

local stopRequested = false
local function renderModel(target)
  target = target or Selection:Get()[1]
  if not target or not (target:IsA('Model') or target:IsA('BasePart')) then
    setStatus('Select a Model or Part in the Explorer first.', WARN)
    return
  end
  local cam = workspace.CurrentCamera
  if not cam then
    setStatus('No viewport camera found.', BAD)
    return
  end
  state.token += 1
  setStatus('Rendering the model on a white and a black backdrop...', WARN)
  local oldCF, oldFov, oldFocus, oldSel = cam.CFrame, cam.FieldOfView, cam.Focus, Selection:Get()
  Selection:Set({})
  -- game GUIs in StarterGui are drawn in the edit viewport and would end up in the shot, so hide them
  local hiddenGuis = {}
  for _, d in ipairs(StarterGui:GetDescendants()) do
    if d:IsA('LayerCollector') and d.Enabled then
      hiddenGuis[#hiddenGuis + 1] = d
      d.Enabled = false
    end
  end
  local clone, back, imgW, imgB
  local lightingBefore = {}
  for _, key in ipairs({ 'Ambient', 'OutdoorAmbient', 'Brightness', 'ClockTime', 'ExposureCompensation' }) do lightingBefore[key] = Lighting[key] end
  local ok, problem = pcall(function()
    if state.opts.lightPreset == 'Bright studio' then
      Lighting.Ambient = rgb(130, 140, 160) Lighting.OutdoorAmbient = rgb(150, 155, 170)
      Lighting.Brightness = 2 Lighting.ClockTime = 14 Lighting.ExposureCompensation = 0
    elseif state.opts.lightPreset == 'Dramatic' then
      Lighting.Ambient = rgb(40, 45, 65) Lighting.OutdoorAmbient = rgb(55, 65, 90)
      Lighting.Brightness = 3 Lighting.ClockTime = 17 Lighting.ExposureCompensation = 0
    elseif state.opts.lightPreset == 'Flat' then
      Lighting.Ambient = rgb(200, 200, 200) Lighting.OutdoorAmbient = rgb(200, 200, 200)
      Lighting.Brightness = 0 Lighting.ExposureCompensation = 0
    end
    clone = target:Clone()
    if not clone then error('Model cannot be cloned. Enable Archivable on the source.') end
    for _, d in ipairs(clone:GetDescendants()) do
      if d:IsA('BaseScript') then d:Destroy()
      elseif d:IsA('BasePart') then d.Anchored = true d.CanCollide = false end
      if d:IsA('ParticleEmitter') or d:IsA('Trail') then d.Enabled = false end
    end
    if clone:IsA('BasePart') then clone.Anchored = true clone.CanCollide = false end
    local variantColor = ({ Red = rgb(245, 80, 90), Blue = rgb(65, 145, 255), Gold = rgb(255, 202, 65) })[state.opts.variant]
    if variantColor then
      local objects = clone:GetDescendants()
      table.insert(objects, clone)
      for _, d in ipairs(objects) do
        if d:IsA('BasePart') then d.Color = variantColor end
      end
    end
    local cf, size
    if clone:IsA('Model') then cf, size = clone:GetBoundingBox() else cf, size = clone.CFrame, clone.Size end
    -- shoot a copy high up in the sky so nothing else is in the frame
    local origin = CFrame.new(0, 40000, 0)
    -- Match the live preview's world-space orientation: relocate only.
    -- Inverting the bounding-box CFrame also undid the source model's rotation.
    local moved = CFrame.new(origin.Position - cf.Position)
    if clone:IsA('Model') then clone:PivotTo(moved * clone:GetPivot()) else clone.CFrame = moved * clone.CFrame end
    clone.Parent = workspace
    local animationId = string.match(state.opts.animationId or '', '%d+')
    if animationId then
      local host = clone:FindFirstChildWhichIsA('Humanoid', true) or clone:FindFirstChildWhichIsA('AnimationController', true)
      if not host then error('This model has no Humanoid or AnimationController for posing.') end
      local animator = host:FindFirstChildOfClass('Animator') or Instance.new('Animator', host)
      local root = clone:FindFirstChild('HumanoidRootPart', true) or (clone:IsA('Model') and clone.PrimaryPart)
      if not root then error('Posed rigs need a HumanoidRootPart or PrimaryPart.') end
      for _, d in ipairs(clone:GetDescendants()) do if d:IsA('BasePart') then d.Anchored = d == root end end
      local animation = Instance.new('Animation')
      animation.AnimationId = 'rbxassetid://' .. animationId
      animation.Parent = clone
      local track = animator:LoadAnimation(animation)
      track:Play(0, 1, 0)
      local deadline = os.clock() + 8
      repeat task.wait() until track.Length > 0 or os.clock() > deadline
      if track.Length == 0 then error('Animation could not load. Check ID, ownership and rig compatibility.') end
      track.TimePosition = math.clamp(state.opts.poseTime, 0, math.max(0, track.Length - 0.001))
      settle()
      local posedCF, posedSize = clone:GetBoundingBox()
      clone:PivotTo(CFrame.new(origin.Position - posedCF.Position) * clone:GetPivot())
      size = posedSize
    end
    local radius = math.max(size.Magnitude / 2, 0.5)
    local fov = state.opts.fov
    local vp = cam.ViewportSize
    local vfov = math.rad(fov)
    local hfov = 2 * math.atan(math.tan(vfov / 2) * (vp.X / math.max(vp.Y, 1)))
    local dist = radius / math.sin(math.min(vfov, hfov) / 2) * 1.08 * 100 / state.opts.zoom
    local dir = (VIEW_DIRS[state.modelView] or VIEW_DIRS['3/4']).Unit
    if state.modelView == 'Custom' then
      local yaw, pitch = math.rad(state.opts.yaw), math.rad(state.opts.pitch)
      dir = Vector3.new(math.sin(yaw) * math.cos(pitch), math.sin(pitch), -math.cos(yaw) * math.cos(pitch))
    end
    local center = origin.Position
    local camPos = center + dir * dist
    local behind = dist + radius + 4
    local half = math.tan(math.max(vfov, hfov) / 2) * behind * 2.5 + 50
    back = Instance.new('Part')
    back.Anchored = true
    back.CanCollide = false
    back.CastShadow = false
    back.Locked = true
    back.Material = Enum.Material.Neon
    back.Size = Vector3.new(half * 2, half * 2, 1)
    back.CFrame = CFrame.lookAt(center - dir * (radius + 4), camPos)
    back.Color = rgb(255, 255, 255)
    back.Parent = workspace
    cam.FieldOfView = fov
    -- Studio re-aims the editor camera at its old Focus a moment after CFrame is set, so move Focus too
    cam.Focus = CFrame.new(center)
    cam.CFrame = CFrame.lookAt(camPos, center) * CFrame.new(size.Magnitude * state.opts.panX / 100, size.Magnitude * state.opts.panY / 100, 0) * CFrame.Angles(0, 0, math.rad(state.opts.roll))
    cam.Focus = CFrame.new(cam.CFrame.Position + cam.CFrame.LookVector * dist)
    settle()
    local e1, e2
    imgW, e1 = takeScreenshot()
    if not imgW then error(e1) end
    if stopRequested then error('Capture cancelled') end
    back.Color = rgb(0, 0, 0)
    settle()
    imgB, e2 = takeScreenshot()
    if not imgB then error(e2) end
  end)
  if back then back:Destroy() end
  if clone then clone:Destroy() end
  for key, value in pairs(lightingBefore) do Lighting[key] = value end
  for _, g in ipairs(hiddenGuis) do
    if g.Parent then g.Enabled = true end
  end
  cam.Focus = oldFocus
  cam.CFrame = oldCF
  cam.FieldOfView = oldFov
  Selection:Set(oldSel)
  if not ok then
    if imgW then imgW:Destroy() end
    if imgB then imgB:Destroy() end
    setStatus('Model render failed: ' .. tostring(problem), BAD)
    return
  end
  local sW, sB = imgW.Size, imgB.Size
  if sW ~= sB then
    imgW:Destroy() imgB:Destroy()
    setStatus('The two renders had different sizes. Try again.', BAD)
    return
  end
  local w, h = math.floor(sW.X + 0.5), math.floor(sW.Y + 0.5)
  local okM, out, info = pcall(function()
    local bW = imgW:ReadPixelsBuffer(Vector2.zero, sW)
    local bB = imgB:ReadPixelsBuffer(Vector2.zero, sB)
    return Matte.fromTwoShots(bW, bB, w, h, { step = function() task.wait() return not stopRequested end })
  end)
  imgB:Destroy()
  if not okM or not out then
    imgW:Destroy()
    setStatus('Model render failed: ' .. tostring(okM and info or out), BAD)
    return
  end
  local captureName = target.Name .. (state.opts.variant ~= 'Original' and (' ' .. state.opts.variant) or '')
  if setSource(imgW, captureName, 'model') then
    state.origBuf = buffer.create(buffer.len(out))
    buffer.copy(state.origBuf, 0, out)
    out = postProcess(out, { step = function() task.wait() return true end })
    applyResult(out, info.bbox)
    setStatus('Ready. Rendered the ' .. state.modelView .. ' view with real transparency.', GOOD)
    state.captureTarget = target
    return true
  end
end

---------------------------------------------------------------- export
local function uploadResult()
  if not state.resultBuf then
    setStatus('Remove a background first.', WARN)
    return
  end
  local L = currentLayout()
  if L.ew > 1024 or L.eh > 1024 then
    setStatus('Choose 1024, 512 or 256 under Max export size before uploading. This upload path uses EditableImage, limited to 1024 pixels per side.', WARN)
    return
  end
  setStatus('Preparing the export...', WARN)
  local buf = Matte.render(state.resultBuf, state.w, state.h, L, { step = function() task.wait() return true end })
  if not buf then
    setStatus('Export cancelled while preparing the image.', WARN)
    return
  end
  local img = AssetService:CreateEditableImage({ Size = Vector2.new(L.ew, L.eh) })
  if not img then
    setStatus('Export failed: Studio has run out of EditableImage memory. Close other image tools and try again.', BAD)
    return
  end
  img:WritePixelsBuffer(Vector2.zero, Vector2.new(L.ew, L.eh), buf)
  setStatus('Uploading...', WARN)
  local base = (string.gsub(state.name, '%.%w+$', ''))
  local requestParameters = {
    Name = base .. ' Icon',
    Description = 'Created with Take a 3D Icon',
  }
  local ok, a, b = pcall(function()
    return AssetService:CreateAssetAsync(img, Enum.AssetType.Image, requestParameters)
  end)
  img:Destroy()
  if not ok then
    setStatus('Upload failed: ' .. tostring(a) .. ' (Install this .rbxmx locally in Studio Plugins.)', BAD)
    return
  end
  local id
  if typeof(a) == 'EnumItem' then
    if a ~= Enum.CreateAssetResult.Success then
      setStatus('Upload failed: ' .. tostring(a) .. (b and (' · ' .. tostring(b)) or ''), BAD)
      return
    end
    id = b
  elseif typeof(a) == 'number' then
    id = a
  elseif typeof(a) == 'table' then
    id = a.AssetId or a.assetId or a.Id
  end
  if not id then
    setStatus('Upload finished but no asset ID came back: ' .. tostring(a), WARN)
    return
  end
  state.lastAssetId = id
  local history = plugin:GetSetting('Take3DIconLibrary') or {}
  if typeof(history) ~= 'table' then history = {} end
  table.insert(history, 1, { name = base, id = tostring(id), date = os.time() })
  while #history > 100 do table.remove(history) end
  pcall(function() plugin:SetSetting('Take3DIconLibrary', history) end)
  idBox.Text = 'rbxassetid://' .. tostring(id)
  setStatus('Uploaded. The ID is in the box above (new images can take a moment to pass moderation).', GOOD)
  return id
end

local function insertImageLabel()
  if not state.lastAssetId then
    setStatus('Upload the image first, then insert it.', WARN)
    return
  end
  local parent = Selection:Get()[1]
  if not parent or not (parent:IsA('GuiObject') or parent:IsA('LayerCollector')) then
    parent = StarterGui:FindFirstChildOfClass('ScreenGui')
    if not parent then
      parent = new('ScreenGui', { Name = 'RemoveBG' }, StarterGui)
    end
  end
  local L = currentLayout()
  local scale = math.min(1, 256 / math.max(L.ew, L.eh))
  local lbl = new('ImageLabel', {
    Name = 'NoBgImage', BackgroundTransparency = 1, Image = 'rbxassetid://' .. tostring(state.lastAssetId),
    Size = UDim2.fromOffset(math.max(1, math.floor(L.ew * scale)), math.max(1, math.floor(L.eh * scale))),
  }, parent)
  Selection:Set({ lbl })
  ChangeHistoryService:SetWaypoint('Insert Remove bg image')
  setStatus('Inserted an ImageLabel into ' .. parent.Name .. '.', GOOD)
end

