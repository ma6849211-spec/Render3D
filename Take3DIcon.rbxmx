				<ProtectedString name="Source"><![CDATA[-- Non-destructive RGBA styles. These are image treatments, not replacement shaders.
local Effects = {}
function Effects.apply(src, w, h, style, hooks)
  if not style or style == 'Clean' then return src end
  local out = buffer.create(buffer.len(src))
  buffer.copy(out, 0, src)
  local function luminance(x, y)
    local i = (math.clamp(y, 0, h - 1) * w + math.clamp(x, 0, w - 1)) * 4
    return buffer.readu8(src, i) * 0.2126 + buffer.readu8(src, i + 1) * 0.7152 + buffer.readu8(src, i + 2) * 0.0722
  end
  for y = 0, h - 1 do
    for x = 0, w - 1 do
      local i = (y * w + x) * 4
      local r, g, b = buffer.readu8(src, i), buffer.readu8(src, i + 1), buffer.readu8(src, i + 2)
      local l = luminance(x, y)
      if style == 'Silhouette' then
        r, g, b = 26, 30, 48
      elseif style == 'Duotone' then
        local t = l / 255
        r, g, b = 35 + 210 * t, 24 + 181 * t, 89 + 88 * t
      elseif style == 'Cel shade' then
        r, g, b = math.floor(r / 64) * 64, math.floor(g / 64) * 64, math.floor(b / 64) * 64
      elseif style == 'Sketch' then
        local edge = math.abs(luminance(x + 1, y) - luminance(x - 1, y)) + math.abs(luminance(x, y + 1) - luminance(x, y - 1))
        r = math.clamp(245 - edge * 2 - (255 - l) * 0.12, 20, 245)
        g, b = r, r
      elseif style == 'Halftone' then
        local dx, dy = x % 6 - 2.5, y % 6 - 2.5
        local ink = dx * dx + dy * dy < (1 - l / 255) * 18
        r = ink and 30 or 242
        g, b = r, r
      elseif style == 'Pixel art' then
        local sx, sy = math.min(w - 1, math.floor(x / 6) * 6 + 3), math.min(h - 1, math.floor(y / 6) * 6 + 3)
        local p = (sy * w + sx) * 4
        r, g, b = buffer.readu8(src, p), buffer.readu8(src, p + 1), buffer.readu8(src, p + 2)
        buffer.writeu8(out, i + 3, buffer.readu8(src, p + 3))
      end
      buffer.writeu8(out, i, math.clamp(math.floor(r), 0, 255))
      buffer.writeu8(out, i + 1, math.clamp(math.floor(g), 0, 255))
      buffer.writeu8(out, i + 2, math.clamp(math.floor(b), 0, 255))
    end
    if y % 32 == 0 and hooks and hooks.step and hooks.step(y / h, 'Styling') == false then return nil end
  end
  return out
end

-- Separable alpha blur, composited underneath the subject.
function Effects.aura(src, w, h, radius, shadow, hooks)
  radius = math.clamp(math.floor(radius), 1, 20)
  local horizontal, blurred = buffer.create(w * h * 4), buffer.create(w * h * 4)
  for y = 0, h - 1 do
    local sum = 0
    for x = -radius, radius do
      if x >= 0 and x < w then sum += buffer.readu8(src, (y * w + x) * 4 + 3) end
    end
    for x = 0, w - 1 do
      buffer.writef32(horizontal, (y * w + x) * 4, sum / (radius * 2 + 1))
      local remove, add = x - radius, x + radius + 1
      if remove >= 0 then sum -= buffer.readu8(src, (y * w + remove) * 4 + 3) end
      if add < w then sum += buffer.readu8(src, (y * w + add) * 4 + 3) end
    end
    if y % 32 == 0 and hooks and hooks.step and hooks.step(y / h, 'Blurring') == false then return nil end
  end
  for x = 0, w - 1 do
    local sum = 0
    for y = 0, radius do if y < h then sum += buffer.readf32(horizontal, (y * w + x) * 4) end end
    for y = 0, h - 1 do
      buffer.writef32(blurred, (y * w + x) * 4, sum / (radius * 2 + 1))
      local remove, add = y - radius, y + radius + 1
      if remove >= 0 then sum -= buffer.readf32(horizontal, (remove * w + x) * 4) end
      if add < h then sum += buffer.readf32(horizontal, (add * w + x) * 4) end
    end
    if x % 32 == 0 and hooks and hooks.step and hooks.step(x / w, 'Blurring') == false then return nil end
  end
  local out = buffer.create(buffer.len(src))
  for y = 0, h - 1 do
    for x = 0, w - 1 do
      local i = (y * w + x) * 4
      local sx, sy = x - (shadow and radius or 0), y - (shadow and radius or 0)
      local a = buffer.readu8(src, i + 3) / 255
      local under = 0
      if sx >= 0 and sy >= 0 then under = buffer.readf32(blurred, (sy * w + sx) * 4) / 255 * (shadow and 0.65 or 0.9) end
      local alpha = a + under * (1 - a)
      for c = 0, 2 do
        local color = shadow and 15 or ({ 110, 180, 255 })[c + 1]
        local value = alpha > 0 and (buffer.readu8(src, i + c) * a + color * under * (1 - a)) / alpha or 0
        buffer.writeu8(out, i + c, math.clamp(math.floor(value), 0, 255))
      end
      buffer.writeu8(out, i + 3, math.clamp(math.floor(alpha * 255), 0, 255))
    end
  end
  return out
end
return Effects]]></ProtectedString>
